# Copiá este archivo como .env (sin .example). Nunca subas claves reales a Git.
# Sin clave, el curso funciona completo en modo offline (gratis).

# offline: herramientas y grafos reales con un "guion" en lugar del modelo. live: usa OpenAI.
COURSE_MODE=offline
OPENAI_API_KEY=

# Modelos GPT-6 (octubre 2026). Ver https://developers.openai.com/api/docs/models
#   gpt-6-luna   → económico y rápido ($0.1 / $0.5 por millón de tokens)  · clases 0–4
#   gpt-6.1-sol  → equilibrio ($2 / $10)                                  · coordinador de la clase 5
#   gpt-6-astra  → máxima capacidad ($10 / $50)                           · solo demostraciones puntuales
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_AGENT=gpt-6.1-sol

# RAG: generación acotada con Luna; coordinación Agentic RAG usa OPENAI_MODEL_AGENT.
OPENAI_MODEL_RAG=gpt-6-luna
# Generación vigente de embeddings: large para el experimento semántico en español.
# Puedes comparar con text-embedding-3-small; no es un modelo de chat.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Cuánto "piensa" el modelo antes de responder: none (solo Luna), low, medium, high, xhigh, max.
# Más esfuerzo = más tokens y más costo. low alcanza para estas clases.
OPENAI_REASONING_EFFORT=low
